# Anchor Fullstack - Environment Variables
# Copy this file to .env and fill in the values

# Database (required for production)
# Example: mysql://user:password@localhost:3306/anchor_db
DATABASE_URL=

# JWT Secret (required)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# OpenAI API Key (optional - enables AI features like voice transcription)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: custom base URL for OpenAI-compatible APIs
# OPENAI_BASE_URL=https://api.openai.com/v1

# Storage directory (optional - defaults to ./uploads)
STORAGE_DIR=

# Owner email (optional - first user with this email gets admin role)
OWNER_EMAIL=

# Port (optional - defaults to 3000)
PORT=3000
